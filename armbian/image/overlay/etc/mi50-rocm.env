# systemd EnvironmentFile syntax: literal assignments only; no shell expansion.
ROCM_PATH=/opt/rocm
HIP_PATH=/opt/rocm
HIP_PLATFORM=amd
HSA_USERPTR_FOR_PAGED_MEM=0
TORCH_BLAS_PREFER_HIPBLASLT=0
MI50_POWER_CAP_UW=165000000
PATH=/opt/rocm/bin:/opt/rocm/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
